{
  "expo": {
    "name": "HomeTayo",
    "slug": "hometayo-native",
    "scheme": "hometayo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F7F2",
    "android": {
      "package": "app.hometayo.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#173D32"
      }
    },
    "ios": {
      "bundleIdentifier": "app.hometayo.mobile"
    },
    "extra": {
      "note": "Public API only; never put DB or OAuth secrets in EXPO_PUBLIC vars."
    }
  }
}
