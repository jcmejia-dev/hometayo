# This is the PUBLIC origin of HomeTayo's Vercel app, not a database URL or secret.
EXPO_PUBLIC_API_URL=https://hometayoph.vercel.app
# Same Google Web OAuth client ID as backend AUTH_GOOGLE_ID (public identifier).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Existing Expo project UUID. Configure via eas update:configure or your EAS project settings.
EAS_PROJECT_ID=
# Android Maps SDK key restricted to app.hometayo.mobile and its signing certificate.
GOOGLE_MAPS_ANDROID_API_KEY=
