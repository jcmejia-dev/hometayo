# HomeTayo development only. Never commit actual credentials.
DATABASE_URL=
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# From dedicated Google Cloud OAuth Web Application (localhost:3000 callback).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ENABLE_NATIVE_AUTH=false
ENABLE_EMAIL_PASSWORD_AUTH=false
ENABLE_EMAIL_SIGNUP=false
APP_BASE_URL=https://hometayoph.vercel.app
# Server-only Gmail delivery. Never use EXPO_PUBLIC_ for these credentials.
AUTH_EMAIL_PROVIDER=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Server-only Places API key. Never place this in the Android APK.
GOOGLE_PLACES_API_KEY=
# Enable only after migrations 005 and 006 have been applied and verified.
ENABLE_RENTAL_MANAGEMENT=false
# Browser-restricted public key; enable Maps JavaScript API. Never use the server Places key here.
NEXT_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
